{
  "name": "@vishin-pavel/dfl",
  "version": "0.3.0",
  "description": "Development flow manager: per-step Agent Skills rendered from templates, an xstate-driven flow, a built-in MCP server and a terminal flow viewer for Claude Code, Cursor, Antigravity, Codex, Gemini CLI, Copilot, Windsurf, OpenCode and Kiro.",
  "type": "module",
  "bin": {
    "dfl": "dist/cli.mjs"
  },
  "files": [
    "dist/**/*.mjs",
    "templates",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishin-pavel/dfl.git"
  },
  "homepage": "https://github.com/vishin-pavel/dfl#readme",
  "bugs": {
    "url": "https://github.com/vishin-pavel/dfl/issues"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "mcp",
    "xstate",
    "workflow",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "copilot",
    "windsurf",
    "opencode",
    "kiro",
    "antigravity",
    "jira",
    "cli"
  ],
  "author": {
    "name": "Pavel Vishin",
    "url": "https://github.com/vishin-pavel"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@commander-js/extra-typings": "^15.0.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "commander": "^15.0.0",
    "elkjs": "^0.12.0",
    "handlebars": "^4.7.9",
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "xstate": "^5.33.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "smol-toml": "^1.9.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
